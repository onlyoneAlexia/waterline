{
  "name": "waterline",
  "version": "0.2.0",
  "private": true,
  "description": "Flood-impact simulator: live weather, real terrain and OpenStreetMap in a photorealistic 3D city, with Aholo Lux3D models of the things you own at true scale.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test",
    "generate": "node --env-file-if-exists=.env scripts/generate.mjs",
    "extras": "node --env-file-if-exists=.env scripts/lux3d-extras.mjs",
    "optimise": "node scripts/optimise-library.mjs",
    "thumbs": "node scripts/render-thumbnails.mjs",
    "prewarm": "node scripts/prewarm-data.mjs",
    "verify:interface": "node scripts/verify-interface.mjs",
    "verify:demo": "node scripts/verify-functional.mjs --no-video",
    "capture": "node --env-file-if-exists=.env scripts/capture-sim.mjs",
    "record": "node --env-file-if-exists=.env scripts/record-demo.mjs",
    "submission": "node scripts/prepare-submission.mjs"
  },
  "dependencies": {
    "cesium": "1.145.0",
    "geotiff": "3.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
