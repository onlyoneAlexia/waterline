{
  "name": "waterline",
  "version": "0.1.0",
  "private": true,
  "description": "See a flood against the things you own: Lux3D turns a photo into a true-scale 3D model on your real street, then the water rises.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "generate": "node --env-file-if-exists=.env scripts/generate.mjs",
    "optimise": "node scripts/optimise-library.mjs",
    "thumbs": "node scripts/render-thumbnails.mjs",
    "prewarm": "node scripts/prewarm-data.mjs",
    "test": "node --test",
    "verify:interface": "node scripts/verify-interface.mjs",
    "verify:demo": "node scripts/verify-functional.mjs --no-video",
    "submission": "node scripts/prepare-submission.mjs"
  },
  "dependencies": {
    "cesium": "1.145.0",
    "geotiff": "3.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
