# Copy this file to .env and fill in your keys. Never commit .env.

# Lux3D API key (international): https://labs.aholo.ai/api-keys
LUX3D_API_KEY=

# Cesium ion access token: https://ion.cesium.com/tokens
# In ion's Asset Depot, add "Google Photorealistic 3D Tiles" to your assets.
CESIUM_ION_TOKEN=

# Optional
# PORT=3000
# MAX_GENERATIONS_PER_DAY=40
# MAX_GENERATIONS_PER_IP_PER_HOUR=6
# TRUST_PROXY=1            # set when hosted behind a proxy (Render, Railway, Fly)
# LUX3D_BASE_URL=https://api.aholo.ai/global
